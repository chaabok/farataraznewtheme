// setup-service — installation registry (PostgreSQL-ready)
//
// MIGRATION TO POSTGRESQL:
//   1. provider = "postgresql"
//   2. url      = env("DATABASE_URL")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:/home/z/my-project/db/setup.db"
}

/// Installation registry: for every ERP module, whether it is "selected"
/// (installed in the MAIN database) or not (installed in the SECONDARY
/// database). The actual business records live in the two data databases
/// (see prisma/data.prisma) and are exchanged between them via APIs only.
model ServiceInstall {
  id        String   @id @default(uuid())
  moduleKey String   @unique
  name      String
  selected  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}
