// settings-service — سرویس عمومی (Gnr domain in the legacy system)
// §2.3: 100% PostgreSQL-compatible constructs only (no arrays/enums/JSON types).
// §16 contract: NO autoincrement anywhere — every operational PK is manual via IdGenerationService.

/*
 * AppBaseEntity — بلوک اجباری ۸فیلدی برای «هر» مدل عملیاتیِ آینده
 * (درخواست مالک: «در تمامی جداول از فیلدهای ارث‌بری استفاده کنیم» — تأیید 1405/08/01؛
 *  اصلاح Task 76 در 1405/08/03: چهار ستون مهرِ زمانی شمسی CreationDate/CreationTime/
 *  LastModificationDate/LastModificationTime از بلوک حذف شد — منطق زمانِ ایجاد/ویرایش
 *  را CreatedAt/UpdatedAt پرایسما پوشش می‌دهد؛ Creator/LastModifier برای «چه‌کسی» می‌ماند.
 *  نمایش شمسیِ CreatedAt در UI/گزارش = تبدیل در زمان خواندن با tehranNowParts)
 * قرارداد کامل و توابع پرکردن خودکار: mini-services/_shared/app-base-entity.ts
 *   · create → spread appBaseOnCreate(actor)   · update → spread appBaseOnUpdate(actor)
 *   · خواندن اطلاعات پایه → baseDataScopeWhere(scope, root.isBasicInfoShared)
 *   · مدلِ جدید باید به VERSIONED_MODELS (prisma.service.ts) هم اضافه شود (§2.5).
 * جداول پلتفرمی (Setting/AppRegistry/Systems/IDGeneration/BusinessStructure/
 * BusinessStructureUser) با تأیید مالک مستثنا هستند.
 *
 * model <OperationalEntity> {
 *   ...
 *   version              Int      @default(1) @map("Version")                 // §2.5 rowversion
 *   creator              String               @map("Creator")                 // IAM UserID
 *   lastModifier         String?              @map("LastModifier")
 *   businessStructureRef BigInt               @map("BusinessStructureRef")   // owning node
 *   companyRef           BigInt?              @map("CompanyRef")             // level anchors
 *   branchRef            BigInt?              @map("BranchRef")
 *   agencyRef            BigInt?              @map("AgencyRef")
 *   shopRef              BigInt?              @map("ShopRef")
 *   createdAt            DateTime @default(now()) @map("CreatedAt")          // Task 76: تِک ستون زمان
 *   updatedAt            DateTime @updatedAt      @map("UpdatedAt")
 * }
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// IDGeneration — central per-table counters (legacy "Gnr"."IDGeneration").
/// IDGenerationID itself is manual = MAX(IDGenerationID)+1 inside the same transaction (spec §2).
model IDGeneration {
  idGenerationId BigInt @id @map("IDGenerationID")
  tableName      String @unique @map("TableName")
  lastId         BigInt @default(0) @map("LastID")
  version        Int    @default(1) @map("Version") // §2.5 auto-rowversion (bumps when the counter moves)

  @@map("IDGeneration")
}

/// Generic namespaced settings (bs.shareHeadquarterData, bs.activeStructureTypes, ...)
model Setting {
  key     String @id @map("Key")
  value   String @map("Value")
  version Int    @default(1) @map("Version") // §2.5 auto-rowversion

  @@map("Setting")
}

/// BusinessStructure — tree table (legacy "Gnr"."BusinessStructure").
/// Root node is system-reserved at ID=1 (spec: counter must never reproduce it).
model BusinessStructure {
  id                    BigInt   @id @map("BusinessStructureID")
  parentRef             BigInt             @map("ParentRef") // 0 = root
  code                  String             @map("Code")
  title                 String             @map("Title")
  titleEn               String?            @map("Title_En")
  businessStructureType Int?               @map("BusinessStructure") // 1=Holding 2=Company 3=Branch 4=Agency 5=Store (Task 34)
  manager               String?            @map("Manager")
  logoUrl               String?            @map("LogoUrl")
  isBasicInfoShared     Boolean  @default(false) @map("IsBasicInfoShared")
  activeStructureTypes  String?            @map("ActiveStructureTypes") // JSON "[1,3]"
  isActive              Boolean  @default(true)  @map("IsActive")
  isSystem              Boolean  @default(false) @map("IsSystem")
  version               Int      @default(1)     @map("Version")
  createdAt             DateTime @default(now()) @map("CreatedAt")
  updatedAt             DateTime @updatedAt      @map("UpdatedAt")

  @@unique([parentRef, code])
  @@map("BusinessStructure")
}

/// IAM users authorized per business-structure node (Task 19 will wire auth-service).
model BusinessStructureUser {
  id                 BigInt   @id @map("BusinessStructureUserID")
  businessStructureId BigInt            @map("BusinessStructureID")
  userId             String             @map("UserID")
  version            Int      @default(1)     @map("Version") // §2.5 auto-rowversion
  createdAt          DateTime @default(now()) @map("CreatedAt")

  @@unique([businessStructureId, userId])
  @@map("BusinessStructureUser")
}

/// AppRegistry — platform metadata for the ERP app mesh (Task 18).
/// NOT business data: meta/framework table with string PK (D5 scope, like Setting/FormDefinition).
/// Idempotently synced on boot from mini-services/_shared/app-catalog.ts (single source of truth).
/// dbMode: "shared" (default, one DB for all apps) | "dedicated" (app runs on its own DB).
model AppRegistry {
  appKey    String   @id @map("AppKey")
  titleFa   String   @map("TitleFa")
  titleKey  String   @map("TitleKey")
  iconKey   String   @map("IconKey")
  appGroup  String   @map("AppGroup")
  order     Int      @map("Order")
  port      Int      @map("Port")
  dbMode    String   @default("shared") @map("DbMode")
  host      String   @default("apps-service") @map("Host")
  isEnabled Boolean  @default(true) @map("IsEnabled")
  version   Int      @default(1) @map("Version") // §2.5 auto-rowversion
  createdAt DateTime @default(now()) @map("CreatedAt")
  updatedAt DateTime @updatedAt @map("UpdatedAt")

  @@map("AppRegistry")
}

/// Systems — master registry of ALL ERP software (legacy "Gnr"."Systems", §2.6).
/// Gnr-domain business master data: BigInt manual PK via IdGenerationService (§2.4,
/// never autoincrement), registered in TABLE_REGISTRY as "Systems"/"ID".
/// Idempotently boot-synced from mini-services/_shared/app-catalog.ts (§4.1 single
/// source): missing rows are created, catalog-driven fields updated ONLY on real
/// drift (§2.5 — Version must reflect genuine change), IsActive never overwritten
/// (§4.5 philosophy). i18n of titles via TitleKey → dictionaries.ts (11 locales).
model Systems {
  id        BigInt   @id @map("SystemsID")
  code      String   @unique @map("Code")
  titleFa   String   @map("TitleFa")
  titleKey  String?  @map("TitleKey") // i18n dictionary key; null for future non-catalog software
  iconKey   String   @map("IconKey")
  appGroup  String   @map("AppGroup")
  sortOrder Int      @map("SortOrder")
  isActive  Boolean  @default(true) @map("IsActive")
  version   Int      @default(1) @map("Version") // §2.5 auto-rowversion
  createdAt DateTime @default(now()) @map("CreatedAt")
  updatedAt DateTime @updatedAt @map("UpdatedAt")

  @@map("Systems")
}

/// SoftwareConfig — Task 72 (تأیید مالک): «پیکربندی نرم افزارها» — تنظیمات هر
/// نرم‌افزارِ سیستم در پنجرهٔ تنظیمات (تب‌های عمومی/حسابداری/دریافت و پرداخت/
/// انبار/فروش/دارایی ثابت/حقوق). هر فیلد پیکربندی = یک ردیف کلید/مقدار تا
/// فیلدهای «به‌مرور اعلام‌شوندهٔ» مالک بدون هیچ مهاجرت دیتابیسی فقط ردیف بگیرند.
/// AppKey = appKey کاتالوگ (general|accounting|receiptsPayment|inventory|sales|
/// fixedAssets|payroll — بعداً گسترش می‌یابد)؛ ConfigValue رشته‌ای است (§2.3).
/// §16: ID دستی از IDGeneration ("SoftwareConfig")؛ بلوک کامل ارث‌بری
/// AppBaseEntity ۸فیلدی (درخواست مالک؛ نسخهٔ Task 76 — مهر زمانی با CreatedAt/UpdatedAt) —
/// درخواست‌کننده تا استقرار IAM = SYSTEM_ACTOR (دفتر مرکزی، ID=1).
/// Unique شامل BusinessStructureRef است تا پیکربندی تفکیکی هر شرکت/شعبه در
/// آینده بدون تغییر اسکیما ممکن شود (پیش‌فرض تأییدشدهٔ مشاورهٔ Task 72).
model SoftwareConfig {
  id                   BigInt   @id @map("SoftwareConfigID")
  appKey               String   @map("AppKey")
  configKey            String   @map("ConfigKey")
  configValue          String?  @map("ConfigValue") // "" = حذف (الگوی Task 68)
  version              Int      @default(1) @map("Version") // §2.5 auto-rowversion
  creator              String   @map("Creator") // IAM UserID
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  @@unique([appKey, configKey, businessStructureRef])
  @@map("SoftwareConfig")
}

/// FiscalYear — Task 75 (درخواست مالک): فرم «سال مالی جدید» در پنجرهٔ نرم‌افزار
/// «عمومی» → زیرمنوی «اطلاعات پایه». اطلاعات پایهٔ تقویم مالی سیستم (دامنهٔ Gnr):
///   · Code  — کد سال مالی، اجباری، در ساختار سازمانی یکتا (unique با BSRef).
///   · Title — عنوان سال مالی، اجباری، فقط عدد و دقیقاً ۴ کاراکتر (مثل «1404»)
///             و یکتا در ساختار سازمانی (unique با BSRef) — «سال مالی تکراری» رد.
///   · StartDate/EndDate — میلادی 'YYYY-MM-DD' (Task 77: «تمامی ستون‌های از نوع
///             تاریخ فقط میلادی ذخیره شوند» — نمایش تقویمِ زبان انتخابی فقط در فرانت؛
///             فرانتِ fa/ps/ckb شمسی نشان می‌دهد و پیش از ارسال تبدیل می‌کند)؛
///             بازهٔ تکراری (هم‌پوشانی) رد؛ طول بازه بیش از «تعداد ماه‌های مالی»
///             پیکربندی نرم‌افزار/حسابداری (SoftwareConfig fiscalMonthsCount،
///             پیش‌فرض ۱۲) رد می‌شود.
///   · IsActive — «فعال».
/// §16: ID دستی از IDGeneration ("FiscalYear")؛ بلوک کامل ارث‌بری AppBaseEntity
/// ۸فیلدی (قرارداد اجباری مالک؛ نسخهٔ Task 76) — تا استقرار IAM = SYSTEM_ACTOR (دفتر مرکزی، ID=1).
model FiscalYear {
  id                   BigInt   @id @map("FiscalYearID")
  code                 String   @map("Code")
  title                String   @map("Title") // فقط عدد، ۴ کاراکتر
  startDate            String?  @map("StartDate") // Gregorian 'YYYY-MM-DD' (Task 77)
  endDate              String?  @map("EndDate") // Gregorian 'YYYY-MM-DD' (Task 77)
  isActive             Boolean  @default(true) @map("IsActive")
  version              Int      @default(1) @map("Version") // §2.5 auto-rowversion
  creator              String   @map("Creator") // IAM UserID
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  @@unique([code, businessStructureRef])
  @@unique([title, businessStructureRef])
  @@map("FiscalYear")
}

/// CurrencyType — Task 114 (درخواست مالک): فرم «نوع ارز جدید» در نرم‌افزار
/// «عمومی» → زیرمنوی «اطلاعات پایه» (اطلاعات پایهٔ ارزی سیستم).
/// فیلدها عین تصویر مالک: کد*، عنوان*، عنوان لاتین*، واحد مبنا*،
/// تعداد اعشار*، عنوان اعشار، عنوان اعشار لاتین، ثبت فعال.
/// کد یکتا در ساختار سازمانی؛ seed اولیه = ارزهای معتبر بین‌المللی ISO 4217
/// (idempotent by Code) — ریال ایران + ارزهای major جهان و همسایگان.
model CurrencyType {
  id                BigInt   @id @map("CurrencyTypeID")
  code              String   @map("Code") // کد ارز (مثلاً IRR/USD — ISO 4217)
  title             String   @map("Title") // عنوان فارسی
  titleLatin        String   @map("TitleLatin") // عنوان لاتین (اجباری)
  baseUnit          Int      @default(1) @map("BaseUnit") // واحد مبنا
  decimalPlaces     Int      @default(0) @map("DecimalPlaces") // تعداد اعشار (۰..۳)
  decimalTitle      String?  @map("DecimalTitle") // عنوان اعشار
  decimalTitleLatin String?  @map("DecimalTitleLatin") // عنوان اعشار لاتین
  isActive          Boolean  @default(true) @map("IsActive") // ثبت فعال
  version           Int      @default(1) @map("Version") // §2.5 auto-rowversion
  creator           String   @map("Creator")
  lastModifier      String?  @map("LastModifier")
  businessStructureRef BigInt @map("BusinessStructureRef")
  companyRef        BigInt?  @map("CompanyRef")
  branchRef         BigInt?  @map("BranchRef")
  agencyRef         BigInt?  @map("AgencyRef")
  shopRef           BigInt?  @map("ShopRef")
  createdAt         DateTime @default(now()) @map("CreatedAt")
  updatedAt         DateTime @updatedAt @map("UpdatedAt")

  @@unique([code, businessStructureRef])
  @@unique([title, businessStructureRef])
  @@map("CurrencyType")
}

/// ExchangeRate — Task 116 (درخواست مالک): فرم «نرخ برابری جدید» در نرم‌افزار
/// «عمومی» → زیرمنوی «عملیات» (گروه نوپای منوی عمومی). فیلدها عین تصویر مالک
/// (بدون فیلد شناسه به فرمان مالک: «نیازی به فیلد شناسه نمی باشد»):
///   · تاریخ موثر*          — میلادی 'YYYY-MM-DD' در بانک (قرارداد Task 77)؛
///                            نمایش در تقویم زبان انتخابی سمت فرانت.
///   · ارز مبنا*            — ارجاع به CurrencyType (استخراج نرخ از مبنا).
///   · ارز مورد مبادله*     — ارجاع به CurrencyType؛ ≠ ارز مبنا.
///   · واحد مبادله          — اختیاری؛ خالی = از واحد مبنای ارز مبنای استخراج
///                            می‌شود (placeholder تصویر: «ارز مبنا مبنای استخراج
///                            می‌باشد»).
///   · نرخ برابری 1 واحد*   — عدد مثبت (Decimal روی SQLite پشتیبانی نمی‌شود —
///                            به‌صورت رشتهٔ عددی نرمال‌شده ذخیره می‌شود).
/// یکتایی: (تاریخ موثر + ارز مبنا + ارز مورد مبادله) در ساختار سازمانی —
/// نرخ تکراری همان جفت‌ارز در همان روز رد می‌شود (409 با پیام روشن).
model ExchangeRate {
  id                BigInt   @id @map("ExchangeRateID")
  effectiveDate     String   @map("EffectiveDate") // میلادی 'YYYY-MM-DD' (Task 77)
  baseCurrencyRef   BigInt   @map("BaseCurrencyRef")
  quoteCurrencyRef  BigInt   @map("QuoteCurrencyRef")
  exchangeUnit      Int?     @map("ExchangeUnit") // اختیاری — خالی = از ارز مبنا
  rate              String   @map("Rate") // عدد مثبت به‌صورت رشتهٔ نرمال
  version           Int      @default(1) @map("Version") // §2.5 auto-rowversion
  creator           String   @map("Creator")
  lastModifier      String?  @map("LastModifier")
  businessStructureRef BigInt @map("BusinessStructureRef")
  companyRef        BigInt?  @map("CompanyRef")
  branchRef         BigInt?  @map("BranchRef")
  agencyRef         BigInt?  @map("AgencyRef")
  shopRef           BigInt?  @map("ShopRef")
  createdAt         DateTime @default(now()) @map("CreatedAt")
  updatedAt         DateTime @updatedAt @map("UpdatedAt")

  @@unique([effectiveDate, baseCurrencyRef, quoteCurrencyRef, businessStructureRef])
  @@map("ExchangeRate")
}

/// City — Task 84 (درخواست مالک): جدول شهرها برای دراپ‌داونِ «شهر» در تب
/// «نشانی» فرم «طرف حساب جدید» (ستون‌ها: کد / عنوان / عنوان لاتین / نام استان /
/// نام کشور). جدول مرجعِ اطلاعات پایه؛ seed اولیه با شهرهای major ایران
/// (idempotent by Code) — توسعهٔ بعدی فهرست با همان جدول.
model City {
  id           BigInt   @id @map("CityID")
  code         String   @unique @map("Code")
  title        String   @map("Title")
  titleLatin   String?  @map("TitleLatin")
  provinceName String   @map("ProvinceName")
  countryName  String   @map("CountryName")
  isActive     Boolean  @default(true) @map("IsActive")
  version      Int      @default(1) @map("Version") // §2.5 auto-rowversion
  creator      String   @map("Creator")
  lastModifier String?  @map("LastModifier")
  businessStructureRef BigInt @map("BusinessStructureRef")
  companyRef   BigInt?  @map("CompanyRef")
  branchRef    BigInt?  @map("BranchRef")
  agencyRef    BigInt?  @map("AgencyRef")
  shopRef      BigInt?  @map("ShopRef")
  createdAt    DateTime @default(now()) @map("CreatedAt")
  updatedAt    DateTime @updatedAt @map("UpdatedAt")
  addresses    PartyAddress[]

  @@map("City")
}

/// Party — Task 84 (درخواست مالک): فرم «طرف حساب جدید» در نرم‌افزار «عمومی» ←
/// زیرمنوی «اطلاعات پایه». فیلدهای اصلی (دوستونه RTL):
///   · Nature        — «ماهیت»: natural (شخص حقیقی، پیش‌فرض) | legal (شخص حقوقی).
///   · Subtype       — «نوع فرعی» فقط برای شخص حقوقی فعال؛ در حالت حقیقی پاک.
///   · Name          — «نام»، اجباری.
///   · حقیقی: LastName (اجباری)، LatinName2 / LatinLastName2 (اختیاری).
///   · حقوقی: LatinName (اختیاری).
///   · TafsiliCode   — «کد تفصیلی» اجباری؛ «به‌صورت خودکار از شماره‌گذاری پر
///                     می‌شود» — سرور سریال max+1 می‌دهد؛ نوع تفصیلی: حقیقی ← ۶،
///                     حقوقی ← ۷ (متادیتای حسابداری؛ در DTO برمی‌گردد).
///   · EconomicCode  — «کد اقتصادی» اختیاری.
///   · حقیقی: NationalId (کد ملی)؛ حقوقی: LegalIdentity (شناسه ملی) +
///             RegistrationNo (شماره ثبت) — تغییر ماهیت فیلدهای حالت دیگر را پاک می‌کند.
///   · IsActive      — «فعال» (پیش‌فرض تیک).
/// نقش‌ها/تب «جزئیات»: IsSupplier/IsCustomer/IsSalesAgent + مبلغ مانده + وضعیت
/// بدهکار/بستانکار (مبلغ غیر صفر ⇔ وضعیت اجباری — دولایه).
/// تب «سایر اطلاعات»: PassportNo/Website/Email/MarriageDate/BirthDate —
/// سه‌تای اول/آخری فقط شخص حقیقی؛ تاریخ‌ها میلادی ISO (قرارداد Task 77).
/// §16: ID دستی از IDGeneration؛ بلوک کامل AppBaseEntity ۸فیلدی (Task 76).
model Party {
  id                   BigInt   @id @map("PartyID")
  nature               String   @map("Nature") // "natural" | "legal"
  subtype              String?  @map("Subtype") // فقط شخص حقوقی
  name                 String   @map("Name")
  lastName             String?  @map("LastName") // فقط شخص حقیقی
  latinName2           String?  @map("LatinName2") // فقط شخص حقیقی
  latinLastName2       String?  @map("LatinLastName2") // فقط شخص حقیقی
  latinName            String?  @map("LatinName") // فقط شخص حقوقی
  tafsiliCode          Int      @map("TafsiliCode") // شماره‌گذاری خودکار (max+1)
  economicCode         String?  @map("EconomicCode")
  nationalId           String?  @map("NationalId") // فقط شخص حقیقی (کد ملی)
  legalIdentity        String?  @map("LegalIdentity") // فقط شخص حقوقی (شناسه ملی)
  registrationNo       String?  @map("RegistrationNo") // فقط شخص حقوقی (شماره ثبت)
  isActive             Boolean  @default(true) @map("IsActive")
  /* ---- تب «جزئیات» — نقش‌ها (تیک ← مبلغ ← وضعیت) ---- */
  isSupplier           Boolean  @default(false) @map("IsSupplier")
  supplierBalance      Float?   @map("SupplierBalance")
  supplierSide         String?  @map("SupplierSide") // "debtor" | "creditor"
  isCustomer           Boolean  @default(false) @map("IsCustomer")
  customerBalance      Float?   @map("CustomerBalance")
  customerSide         String?  @map("CustomerSide")
  isSalesAgent         Boolean  @default(false) @map("IsSalesAgent")
  salesAgentBalance    Float?   @map("SalesAgentBalance")
  salesAgentSide       String?  @map("SalesAgentSide")
  /* ---- تب «سایر اطلاعات» ---- */
  passportNo           String?  @map("PassportNo") // فقط شخص حقیقی
  website              String?  @map("Website")
  email                String?  @map("Email")
  marriageDate         String?  @map("MarriageDate") // Gregorian ISO (Task 77)
  birthDate            String?  @map("BirthDate") // Gregorian ISO (Task 77)
  /* ---- بلوک ارث‌بری AppBaseEntity (Task 76) ---- */
  version              Int      @default(1) @map("Version")
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  persons   PartyPerson[]
  addresses PartyAddress[]
  phones    PartyPhone[]

  @@unique([tafsiliCode, businessStructureRef])
  @@map("Party")
}

/// DataTranslation — Task 92 (تأیید مالک): «انبار ترجمهٔ دادهٔ فرم‌های سیستمی».
/// ترجمهٔ «دادهٔ» رکوردهای فرم‌های سیستمی (مثل Party) به زبان‌های فعال —
/// قرارداد هم‌سان با DfbTranslation فرم‌ساز (Task 70) ولی روی بانک اصلی:
///   · EntityType  — نام مدل سیستمی («Party»، بعداً «FiscalYear» و …)
///   · EntityID    — شناسهٔ رکورد در همان مدل
///   · FieldKey    — کلید فیلد (فیلد ساده «name» یا مسیر ردیف جدولی
///                   «address.0.fullAddress» / «persons.1.notes»)
///   · Locale      — زبان ترجمه (غیر-fa؛ fa خودِ مقدار اصلی رکورد است)
///   · Value       — متن ترجمه‌شده
/// هر دو مسیرِ ترجمهٔ آنلاین (یک فراخوانی LLM در BFF) و ورود دستی (آفلاین)
/// با upsert روی unique چهارگانه می‌نویسند؛ مقدار خالی در ورود دستی = حذف
/// ترجمه (fallback به fa — عین قرارداد DfbTranslationsBody).
/// §16: ID دستی از IDGeneration ("DataTranslation")؛ بلوک کامل ارث‌بری
/// AppBaseEntity ۸فیلدی (قرارداد اجباری مالک) — تا استقرار IAM = SYSTEM_ACTOR.
model DataTranslation {
  id                   BigInt   @id @map("DataTranslationID")
  entityType           String   @map("EntityType") // سقف ۴۰ نویسه در DTO/service
  entityId             BigInt   @map("EntityID")
  fieldKey             String   @map("FieldKey") // سقف ۱۲۰ نویسه در DTO/service
  locale               String   @map("Locale") // سقف ۸ نویسه در DTO/service
  value                String   @map("Value") // سقف ۱۰۰۰ نویسه در DTO/service
  version              Int      @default(1) @map("Version")
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  @@unique([entityType, entityId, fieldKey, locale])
  @@index([entityType, entityId])
  @@map("DataTranslation")
}

/// UserRole — Task 100 (درخواست مالک): فرم «نقش کاربری جدید» در پنجرهٔ تنظیمات
/// ← مدیریت کاربران. کاربر نقش‌های سازمان خودش را تعریف می‌کند و برای هر نقش
/// «محدودهٔ دسترسی» تعیین می‌کند. محدودهٔ دسترسی دو بُعد دارد:
///   ۱. محدودهٔ نرم‌افزاری — کدام نرم‌افزارهای سیستم (Systems.Code = appKey کاتالوگ)
///      در فهرست نداشتن ردیف "software" یعنی «همهٔ نرم‌افزارها» (بدون محدودیت).
///   ۲. محدودهٔ ساختار سازمانی — کدام گره‌های BusinessStructure؛ معنای هر گره
///      شامل زیرمجموعه‌هایش است (به هنگام اعمال). نداشتن ردیف "structure" یعنی
///      «کل ساختار سازمانی» (بدون محدودیت).
/// IsSystem: نقش سیستمیِ seedشده («مدیر سیستم») — حذف آن رد می‌شود.
/// §16: ID دستی از IDGeneration ("UserRole"/"UserRoleScope")؛ بلوک کامل
/// ارث‌بری AppBaseEntity ۸فیلدی (قرارداد اجباری مالک) — تا استقرار IAM =
/// SYSTEM_ACTOR (دفتر مرکزی، ID=1).
model UserRole {
  id                   BigInt   @id @map("UserRoleID")
  code                 String   @map("Code") // کد نقش — اجباری، یکتا در ساختار سازمانی
  title                String   @map("Title") // عنوان نقش — اجباری، یکتا در ساختار سازمانی
  description          String?  @map("Description") // توضیحات (اختیاری)
  isActive             Boolean  @default(true) @map("IsActive")
  isSystem             Boolean  @default(false) @map("IsSystem") // نقش سیستمی — حذف رد می‌شود
  version              Int      @default(1) @map("Version") // §2.5 auto-rowversion
  creator              String   @map("Creator") // IAM UserID
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  scopes UserRoleScope[]

  @@unique([code, businessStructureRef])
  @@unique([title, businessStructureRef])
  @@map("UserRole")
}

/// UserRoleScope — ردیف‌های محدودهٔ دسترسی هر نقش (بُعد نرم‌افزاری/ساختار).
/// ScopeType = "software" (RefKey = appKey از Systems) | "structure" (RefKey = شناسهٔ گرهٔ BusinessStructure).
/// بازنویسی کامل با هر ثبت/ویرایش نقش (الگوی تب‌های طرف حساب) — idempotent روی unique سه‌گانه.
model UserRoleScope {
  id                   BigInt   @id @map("UserRoleScopeID")
  userRoleRef          BigInt   @map("UserRoleRef")
  scopeType            String   @map("ScopeType") // "software" | "structure"
  refKey               String   @map("RefKey") // appKey یا شناسهٔ گرهٔ ساختار (رشته — §2.3)
  version              Int      @default(1) @map("Version")
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")
  userRole             UserRole @relation(fields: [userRoleRef], references: [id], onDelete: Cascade)

  @@unique([userRoleRef, scopeType, refKey])
  @@index([userRoleRef])
  @@map("UserRoleScope")
}

/// GeoLocation — Task 103 (درخواست مالک): فرم «محل های جغرافیایی» در نرم‌افزار
/// «عمومی» ← زیرمنوی «اطلاعات پایه» با کامپوننت SimpleTreeForm. درخت مرجع
/// مکان‌ها (legacy "Gnr"."GeoLocation"):
///   · LevelType — 1=کشور 2=استان 3=شهر 4=روستا 5=خیابان 6=کوچه (ترتیب مالک)
///   · قواعد درخت (تک‌منبع حقیقت روی سرور، عین عبارت مالک): ریشه (ParentRef=0)
///     فقط کشور؛ زیر کشور فقط استان؛ زیر استان فقط شهر. ادامهٔ طبیعی سطوح
///     پایین‌تر (فرض اعلام‌شدهٔ کارنام Task 103): زیر شهر خیابان/روستا؛ زیر
///     روستا/خیابان کوچه؛ کوچه برگ است.
///   · Code عددی اجباری و یکتا بین خواهرها (پیشنهاد خودکار = بیشینهٔ خواهرها + ۱)؛
///     Title/TitleLatin اجباری؛ IsActive پیش‌فرض تیک.
/// §16: ID دستی از IDGeneration ("GeoLocation")؛ بلوک کامل ارث‌بری
/// AppBaseEntity ۸فیلدی — تا استقرار IAM = SYSTEM_ACTOR (دفتر مرکزی، ID=1).
model GeoLocation {
  id                   BigInt   @id @map("GeoLocationID")
  parentRef            BigInt   @default(0) @map("ParentRef") // 0 = ریشهٔ مجازی فرم (کشور)
  levelType            Int      @map("LevelType") // 1=Country 2=Province 3=City 4=Village 5=Street 6=Alley
  code                 Int      @map("Code") // عددی، یکتا بین خواهرها
  title                String   @map("Title")
  titleLatin           String   @map("TitleLatin")
  isActive             Boolean  @default(true) @map("IsActive")
  version              Int      @default(1) @map("Version") // §2.5 auto-rowversion
  creator              String   @map("Creator") // IAM UserID
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  @@unique([parentRef, code])
  @@map("GeoLocation")
}

/// PartyPerson — تب «افراد مرتبط»: نام / نام خانوادگی (اجباری) / نسبت /
/// کد ملی / شماره تلفن / توضیحات. با ثبت/ویرایشِ طرف حساب بازنویسی می‌شود.
model PartyPerson {
  id                   BigInt   @id @map("PartyPersonID")
  partyRef             BigInt   @map("PartyRef")
  firstName            String   @map("FirstName")
  lastName             String   @map("LastName")
  relation             String?  @map("Relation")
  nationalId           String?  @map("NationalId")
  phone                String?  @map("Phone")
  notes                String?  @map("Notes")
  orderIndex           Int      @default(0) @map("OrderIndex")
  version              Int      @default(1) @map("Version")
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")
  party                Party    @relation(fields: [partyRef], references: [id], onDelete: Cascade)

  @@map("PartyPerson")
}

/// PartyAddress — تب «نشانی»: نوع آدرس (اجباری) / شهر از جدول شهرها (اجباری،
/// CityRef + عکسِ عنوان برای نمایش) / آدرس کامل (اجباری) / کد پستی /
/// طول و عرض جغرافیایی.
model PartyAddress {
  id                   BigInt   @id @map("PartyAddressID")
  partyRef             BigInt   @map("PartyRef")
  addrType             String   @map("AddrType") // official | workplace | invoice | goods | warehouse | home | postal | other
  cityRef              BigInt?  @map("CityRef")
  cityTitle            String?  @map("CityTitle") // عکس عنوانِ شهر در زمان ثبت
  fullAddress          String   @map("FullAddress")
  postalCode           String?  @map("PostalCode")
  longitude            Float?   @map("Longitude")
  latitude             Float?   @map("Latitude")
  orderIndex           Int      @default(0) @map("OrderIndex")
  version              Int      @default(1) @map("Version")
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")
  party                Party    @relation(fields: [partyRef], references: [id], onDelete: Cascade)
  city                 City?    @relation(fields: [cityRef], references: [id], onDelete: SetNull)

  @@map("PartyAddress")
}

/// PartyPhone — تب «تلفن»: نوع تلفن / شماره / داخلی / توضیحات.
model PartyPhone {
  id                   BigInt   @id @map("PartyPhoneID")
  partyRef             BigInt   @map("PartyRef")
  phoneType            String   @map("PhoneType") // office | mobile | home | other | faxOffice | faxHome | faxOther
  number               String?  @map("Number")
  extension            String?  @map("Extension")
  notes                String?  @map("Notes")
  orderIndex           Int      @default(0) @map("OrderIndex")
  version              Int      @default(1) @map("Version")
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")
  party                Party    @relation(fields: [partyRef], references: [id], onDelete: Cascade)

  @@map("PartyPhone")
}

/// DetailType — Task 120 (درخواست مالک): فرم «نوع تفصیل جدید» در نرم‌افزار
/// «حسابداری» → زیرمنوی «اطلاعات پایه». فیلدها عین تصویر مالک و بدون عنوان
/// لاتین (فرمان صریح مالک: «عنوان لاتین را نیاز نداریم که در فرم باشد»):
///   · کد*          — یکتا در ساختار سازمانی (مثل CUST/SUPP/BANK).
///   · عنوان*       — یکتا در ساختار سازمانی (مثل مشتریان/تامین‌کنندگان).
///   · فعال است     — بولی (پیش‌فرض فعال).
///   · توضیحات      — اختیاری (متن چندخطی).
/// بدون فیلد شناسه در فرم — ID از IDGeneration (§16).
model DetailType {
  id                   BigInt   @id @map("DetailTypeID")
  code                 String   @map("Code") // کد نوع تفصیل (یکتا در ساختار)
  title                String   @map("Title") // عنوان فارسی (یکتا در ساختار)
  description          String?  @map("Description") // توضیحات اختیاری
  isActive             Boolean  @default(true) @map("IsActive") // فعال است
  version              Int      @default(1) @map("Version") // §2.5 auto-rowversion
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  @@unique([code, businessStructureRef])
  @@unique([title, businessStructureRef])
  @@map("DetailType")
}
