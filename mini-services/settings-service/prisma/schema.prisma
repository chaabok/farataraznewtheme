// settings-service - Prisma schema (PostgreSQL-ready)
//
// MIGRATION TO POSTGRESQL:
//   1. provider = "postgresql"
//   2. url      = env("DATABASE_URL")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:/home/z/my-project/db/settings.db"
}

model Setting {
  id        String   @id @default(uuid())
  key String @unique
  value String
  category String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Multi-company backbone: the hierarchical business-structure tree
/// (system root → headquarter → company → branch → agency) that feeds
/// the future `x-company-id` tenant header of the whole ERP.
/// Structure types: 0=System root (reserved) · 1=Headquarter/Holding ·
/// 2=Company · 3=Branch · 4=Agency (clean greenfield enum — legacy
/// "Department" mismatch intentionally not carried over).
model BusinessStructure {
  id            String   @id @default(uuid())
  /// Parent node id — the virtual root uses the literal "0".
  parentRef     String   @default("0")
  /// Hierarchical code («01», «01-01», …) generated server-side inside a
  /// transaction; unique per parent to allow the same suffix under siblings.
  code          String
  title         String
  titleEn       String?
  structureType Int      @default(2)
  manager       String?
  /// Logo as a data URL (sandbox scale) — swapped for an upload URL later.
  logoUrl       String?
  isActive      Boolean  @default(true)
  /// The single reserved system root («ساختار سیستم») — immutable identity,
  /// never deletable, never seeded with default data.
  isSystem      Boolean  @default(false)
  /// Optimistic-locking counter (consumed by hardening phase).
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([parentRef, code])
  @@index([parentRef])
  @@index([structureType])
}

/// A database-defined ERP form (simple | tabbed | tree), owned by a module.
model FormDefinition {
  id          String   @id @default(uuid())
  moduleKey   String
  formKey     String
  name        String   // fa base name
  nameEn      String?
  type        String   @default("tabbed") // simple | tabbed | tree
  iconKey     String   @default("fileText")
  accentColor String   @default("#0ea5e9")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  fields      FormFieldDefinition[]
  records     FormDataRecord[]
  @@unique([moduleKey, formKey])
  @@index([moduleKey])
}

/// One field of a FormDefinition (ordered, tabbed, typed).
model FormFieldDefinition {
  id           String   @id @default(uuid())
  formId       String
  tabKey       String?  // null = main section
  tabName      String?  // fa tab label
  tabNameEn    String?
  fieldKey     String
  label        String   // fa
  labelEn      String?
  fieldType    String   @default("text") // text|number|date|checkbox|lookup|textarea
  isRequired   Boolean  @default(false)
  span         Int      @default(1) // 1 half, 2 full
  lookupKey    String?
  defaultValue String?
  sortOrder    Int      @default(0)
  /// Column-filter dropdown mode of the data-list window (null = multi)
  filterMode   String?  // single | multi
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  form         FormDefinition @relation(fields: [formId], references: [id], onDelete: Cascade)
  @@unique([formId, fieldKey])
  @@index([formId, sortOrder])
}

/// Options for lookup fields (flat or tree via parentId), grouped by lookupKey.
model FormLookupOption {
  id        String   @id @default(uuid())
  lookupKey String
  code      String
  label     String   // fa
  labelEn   String?
  parentId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([lookupKey, sortOrder])
}

/// One saved record of a form: dataJson = JSON.stringify({fieldKey: value}).
model FormDataRecord {
  id        String   @id @default(uuid())
  formId    String
  dataJson  String   // JSON.stringify({fieldKey: value})
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  form      FormDefinition @relation(fields: [formId], references: [id], onDelete: Cascade)
  @@index([formId, createdAt])
}
