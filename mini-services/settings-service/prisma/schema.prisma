/// DetailType — Task 120 (درخواست مالک): فرم «نوع تفصیل جدید» در نرم‌افزار
/// «حسابداری» → زیرمنوی «اطلاعات پایه». فیلدها عین تصویر مالک و بدون عنوان
/// لاتین (فرمان صریح مالک: «عنوان لاتین را نیاز نداریم که در فرم باشد»):
///   · کد*          — یکتا در ساختار سازمانی (مثل CUST/SUPP/BANK).
///   · عنوان*       — یکتا در ساختار سازمانی (مثل مشتریان/تامین‌کنندگان).
///   · فعال است     — بولی (پیش‌فرض فعال).
///   · توضیحات      — اختیاری (متن چندخطی).
/// بدون فیلد شناسه در فرم — ID از IDGeneration (§16).
model DetailType {
  id                   BigInt   @id @map("DetailTypeID")
  code                 String   @map("Code") // کد نوع تفصیل (یکتا در ساختار)
  title                String   @map("Title") // عنوان فارسی (یکتا در ساختار)
  description          String?  @map("Description") // توضیحات اختیاری
  isActive             Boolean  @default(true) @map("IsActive") // فعال است
  version              Int      @default(1) @map("Version") // §2.5 auto-rowversion
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  @@unique([code, businessStructureRef])
  @@unique([title, businessStructureRef])
  @@map("DetailType")
}

/// DetailTypeNumbering — Task 131 (درخواست مالک): فرم «شماره گذاری تفصیلی ها»
/// در نرم‌افزار «حسابداری» ← زیرمنوی «اطلاعات پایه» (کامپوننت MainDataGrid).
/// به ازای هر نوع تفصیل (DetailType) یک ردیف در هر گرهٔ ساختار سازمانی:
///   · StartNumber/EndNumber — بازهٔ شماره‌گذاری؛ تخصیص خودکار پیوسته
///     (پهنای پیش‌فرض ۱۰۰۰ شماره: MAX(EndNumber)+۱ در همان گره؛ نخستین
///     بازه از ۱ آغاز می‌شود) و ویرایش دستی هم ممکن است.
///   · IsAutomatic — ستون «خودکار» (پیش‌فرض تیک‌خورده — عین تصویر مالک).
///   · IsCompany   — ستون «شرکت» (پیش‌فرض خالی — عین تصویر مالک).
///   · قاعدهٔ مالک: «شماره‌ها نباید با شماره‌های تفصیلی دیگر تداخل داشته
///     باشند» ⇒ بازه‌ها در هر گره با هم تداخل ندارند (کنترل سرور ۴۰۹).
/// اقامت ردیف عین خودِ نوع تفصیل است (آینهٔ ۸فیلد AppBase همان ردیف).
model DetailTypeNumbering {
  id                   BigInt   @id @map("DetailTypeNumberingID") // §2.7
  detailTypeRef        BigInt   @map("DetailTypeRef") // ارجاع به DetailType
  startNumber          BigInt   @map("StartNumber")
  endNumber            BigInt   @map("EndNumber")
  isAutomatic          Boolean  @default(true) @map("IsAutomatic") // خودکار
  isCompany            Boolean  @default(false) @map("IsCompany") // شرکت
  version              Int      @default(1) @map("Version") // §2.5 auto-rowversion
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  @@unique([detailTypeRef, businessStructureRef])
  @@map("DetailTypeNumbering")
}

/// DetailItem — Task 144 (درخواست مالک): فرم «ایجاد تفصیلی ها» در
/// نرم‌افزار «حسابداری» ← زیرمنوی «اطلاعات پایه». رکورد تفصیلی (مقدارِ
/// عملیاتیِ یک نوع تفصیل) که کاربر در فرم ایجاد می‌کند:
///   · detailTypeRef — نوع تفصیل مالکِ این تفصیلی (DetailType).
///   · کد تفصیلی — از بازهٔ شماره‌گذاری همان نوع (Task 131) تخصیص می‌شود:
///     IsAutomatic ⇒ کد خودکار (نخستین عدد بلااستفادهٔ بازه)؛ وگرنه دستی
///     با همان قوانین (عددی، درون بازه، بدون تکرار). قاعدهٔ مالک Task 131
///     «شماره‌ها نباید با شماره‌های تفصیلی دیگر تداخل داشته باشند» ⇒ کد در
///     سطح گرهٔ ساختار یکتاست (فضای شماره‌گذاری مشترک همهٔ انواع).
///   · عنوان — اجباری، یکتا در همان نوع و همان گرهٔ ساختار.
///   · توضیحات اختیاری؛ فعال/غیرفعال.
/// اقامت ردیف = گرهٔ ساختار فعالِ فرم (structureId از OrgScope) با بلوک
/// کامل ارث‌بری AppBaseEntity ۸فیلدی — هم‌قرارداد DetailType.
model DetailItem {
  id                   BigInt   @id @map("DetailItemID") // §2.7
  detailTypeRef        BigInt   @map("DetailTypeRef") // ارجاع به DetailType
  code                 String   @map("Code") // کد تفصیلی (یکتا در گرهٔ ساختار)
  title                String   @map("Title") // عنوان تفصیلی (یکتا در نوع+گره)
  description          String?  @map("Description") // توضیحات اختیاری
  isActive             Boolean  @default(true) @map("IsActive") // فعال است
  version              Int      @default(1) @map("Version") // §2.5 auto-rowversion
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  @@unique([code, businessStructureRef])
  @@unique([detailTypeRef, title, businessStructureRef])
  @@index([detailTypeRef])
  @@map("DetailItem")
}

/// CostCenter — Task 146 (درخواست مالک): فرم «مرکز هزینه جدید» در نرم‌افزار
/// «حسابداری» ← زیرمنوی «اطلاعات تفصیلی ها». مرکز هزینه یک «حساب تفصیلی» است
/// که نوع آن («مراکز هزینه» — کد مرجع ۱۵) در فرم نوع تفصیلی تعریف شده و
/// فرم پایهٔ آن در نرم‌افزار ساخته شده است؛ بنابراین هر مرکز هزینه همزمان
/// یک ردیف DetailItem (کد تفصیل، عنوان، توضیحات، فعال) از آن نوع است +
/// پروفایل اختصاصی همین جدول:
///   · detailItemRef — پیوند ۱:۱ به ردیف تفصیلی مالک (DetailItem).
///   · کد            — کد مرکز هزینه (یکتا در گرهٔ ساختار؛ مستقل از کد تفصیل).
///   · CostCenterType — Enum مالک: ۱=اداری و تشکیلاتی، ۲=بازرگانی،
///     ۳=تولیدی، ۴=خدماتی، ۵=عمومی (SQLite نوع Enum ندارد ⇒ Int با گارد
///     اعتبارسنجی سرویس؛ تعریف Enum در cost-center-type.ts).
///   · کد تفصیل در DetailItem هم‌جدول ذخیره می‌شود و با «متد اختصاصی
///     تخصیص کد تفصیل» (detail-code-assignment — Task 146) بر پایهٔ تنظیمات
///     ساختار کسب و کار (گرهٔ فعال OrgScope) و ردیف شماره‌گذاری همان نوع
///     (ستون‌های شماره شروع/شماره پایان — Task 131) بصورت لایو ایجکس تخصیص می‌یابد.
/// اقامت ردیف = گرهٔ ساختار فعالِ فرم با بلوک کامل ارث‌بری AppBaseEntity.
model CostCenter {
  id              BigInt   @id @map("CostCenterID") // §2.7
  detailItemRef   BigInt   @map("DetailItemRef") // پیوند ۱:۱ به DetailItem
  code            String   @map("Code") // کد مرکز هزینه (یکتا در گرهٔ ساختار)
  costCenterType  Int      @map("CostCenterType") // Enum 1..5 (SQLite: Int)
  version              Int      @default(1) @map("Version") // §2.5 auto-rowversion
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  @@unique([detailItemRef])
  @@unique([code, businessStructureRef])
  @@index([costCenterType])
  @@map("CostCenter")
}

/// Project — Task 147 (درخواست مالک): فرم «تعریف پروژه» در نرم‌افزار
/// «حسابداری» ← زیرمنوی «اطلاعات تفصیلی ها». پروژه یک «حساب تفصیلی» است که
/// نوع آن («پروژه» — کد مرجع ۸ از فرم نوع تفصیلی) از قبل تعریف شده و فرم
/// پایهٔ آن در نرم‌افزار ساخته شده است؛ بنابراین هر پروژه همزمان یک ردیف
/// DetailItem (کد تفصیل، عنوان، توضیحات، فعال) از آن نوع است + پروفایل
/// اختصاصی همین جدول:
///   · detailItemRef — پیوند ۱:۱ به ردیف تفصیلی مالک (DetailItem).
///   · کد            — کد پروژه؛ بنا به فرمان مالک «بصورت سریالی و پشت
///                     سرهم» توسط سرور تخصیص می‌یابد (نخستین عدد بلااستفاده
///                     در گرهٔ ساختار — متد nextSerialCode) و پس از ثبت
///                     تغییرناپذیر است؛ یکتا در گرهٔ ساختار.
///   · کد تفصیل در DetailItem هم‌جدول ذخیره می‌شود و با «متد اختصاصی
///     تخصیص کد تفصیل» (detail-code-assignment — Task 146) بر پایهٔ تنظیمات
///     ساختار کسب و کار و ردیف شماره‌گذاری نوع «پروژه» (ستون‌های شماره
///     شروع/شماره پایان — Task 131) بصورت لایو ایجکس تخصیص می‌یابد.
/// اقامت ردیف = گرهٔ ساختار فعالِ فرم با بلوک کامل ارث‌بری AppBaseEntity.
model Project {
  id              BigInt   @id @map("ProjectID") // §2.7
  detailItemRef   BigInt   @map("DetailItemRef") // پیوند ۱:۱ به DetailItem
  code            String   @map("Code") // کد پروژه (سریالی سرور؛ یکتا در گرهٔ ساختار)
  version              Int      @default(1) @map("Version") // §2.5 auto-rowversion
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  @@unique([detailItemRef])
  @@unique([code, businessStructureRef])
  @@map("Project")
}

/// Contract — Task 148 (درخواست مالک): فرم «قرارداد جدید» در نرم‌افزار
/// «حسابداری» ← زیرمنوی «اطلاعات تفصیلی ها». قرارداد یک «حساب تفصیلی» است
/// که نوع آن («قرارداد» — کد مرجع ۹ از فرم نوع تفصیلی) تعریف شده و فرم
/// پایهٔ آن در نرم‌افزار ساخته شده است؛ بنابراین هر قرارداد همزمان یک ردیف
/// DetailItem (کد تفصیلی، عنوان تفصیلی، شرح، فعال) از آن نوع است + پروفایل
/// اختصاصی همین جدول (عین فیلدهای فرم مالک):
///   · detailItemRef — پیوند ۱:۱ به ردیف تفصیلی مالک (DetailItem).
///   · number        — شماره قرارداد (اجباری؛ یکتا در گرهٔ ساختار).
///   · date          — تاریخ قرارداد (اجباری؛ ذخیرهٔ میلادی ISO — Task 77).
///   · projectRef    — پروژهٔ مرتبط (اختیاری؛ ارجاع به Project).
///   · partyRef      — طرف قرارداد (اجباری؛ ارجاع به Party).
///   · workLocation  — محل انجام کار (اختیاری).
///   · subject/subject2 — موضوع قرارداد / موضوع قرارداد (۲) (اولی اجباری).
///   · title2        — عنوان تفصیلی (۲) (اختیاری؛ اصلی در DetailItem.Title).
///   · startDate/endDate — تاریخ شروع / تاریخ خاتمه (اختیاری؛ ISO).
///   · durationDays  — مدت قرارداد به روز (اختیاری).
///   · amount        — مبلغ قرارداد (اجباری؛ رشتهٔ رقم لاتین — دقت بی‌کاستی).
///   · description2  — شرح (۲) (اختیاری؛ اصلی در DetailItem.Description).
///   · کد تفصیلی در DetailItem هم‌جدول ذخیره می‌شود و با «متد اختصاصی
///     تخصیص کد تفصیل» (detail-code-assignment — Task 146؛ formKey "contract"
///     ← نوع تفصیل «قرارداد» کد ۹) بر پایهٔ تنظیمات ساختار کسب و کار و ردیف
///     شماره‌گذاری همان نوع (ستون‌های شماره شروع/شماره پایان — Task 131)
///     بصورت لایو ایجکس تخصیص می‌یابد — عین قرارداد فرم پروژه (Task 147).
/// اقامت ردیف = گرهٔ ساختار فعالِ فرم با بلوک کامل ارث‌بری AppBaseEntity.
model Contract {
  id              BigInt   @id @map("ContractID") // §2.7
  detailItemRef   BigInt   @map("DetailItemRef") // پیوند ۱:۱ به DetailItem
  number          String   @map("Number") // شماره قرارداد (اجباری؛ یکتا در گرهٔ ساختار)
  date            String   @map("Date") // تاریخ قرارداد — میلادی ISO (Task 77)
  projectRef      BigInt?  @map("ProjectRef") // پروژهٔ مرتبط (اختیاری)
  partyRef        BigInt   @map("PartyRef") // طرف قرارداد (اجباری) → Party
  workLocation    String?  @map("WorkLocation") // محل انجام کار
  subject         String   @map("Subject") // موضوع قرارداد (اجباری)
  subject2        String?  @map("Subject2") // موضوع قرارداد (۲)
  title2          String?  @map("Title2") // عنوان تفصیلی (۲)
  startDate       String?  @map("StartDate") // تاریخ شروع — میلادی ISO
  endDate         String?  @map("EndDate") // تاریخ خاتمه — میلادی ISO
  durationDays    Int?     @map("DurationDays") // مدت قرارداد (روز)
  amount          String   @map("Amount") // مبلغ قرارداد (رقم لاتین — دقت بی‌کاستی)
  description2    String?  @map("Description2") // شرح (۲)
  version              Int      @default(1) @map("Version") // §2.5 auto-rowversion
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  @@unique([detailItemRef])
  @@unique([number, businessStructureRef])
  @@index([projectRef])
  @@index([partyRef])
  @@map("Contract")
}

/// User — Task 126 (درخواست مالک): فرم «کاربر جدید» در تنظیمات ← مدیریت
/// کاربران با کامپوننت SimpleTreeForm. هر کاربر به یک ردیف طرف حساب (لیست
/// «نام / نام خانوادگی») متصل است و یک نقش کاربری (UserRole) دارد.
///   · Username   — اجباری، بیشتر از ۵ نویسه؛ یکتا در هر گرهٔ ساختار.
///   · PasswordHash — scrypt نمک‌دار («salt:hash»)؛ متنِ عبور هرگز ذخیره
///                  نمی‌شود (دکمهٔ «مشاهده» فقط مقدار تایپ‌شدهٔ همین جلسه را
///                  در فرم نشان می‌دهد).
///   · گسترهٔ سازمانی (قاعدهٔ مالک Task 126): فرم به ازای «هر شرکت و هلدینگ»
///     است — ثبت یک کاربر ⇒ یک ردیف برای دفتر مرکزی + یک ردیف برای هر
///     شاخهٔ فعال هلدینگ(1)/شرکت(2) که تیک «استفاده از داده‌های مشترک دفتر
///     مرکزی» (IsBasicInfoShared) ندارد؛ شاخهٔ دارای تیک = کاربران مشترک
///     (فقط ردیف دفتر مرکزی — خواندن با baseDataScopeWhere).
/// §16/§2.4: ID دستی از IDGeneration؛ §2.7: PK = «نام جدول + ID» با نوع
/// BigInt؛ بلوک کامل ارث‌بری AppBaseEntity ۸فیلدی — تا استقرار IAM =
/// SYSTEM_ACTOR (دفتر مرکزی، ID=1).
model User {
  id                   BigInt   @id @map("UserID")
  partyRef             BigInt?  @map("PartyRef") // طرف حساب منتخب (اسنپ‌شات نام در FullName)
  fullName             String   @map("FullName") // «نام + نام خانوادگی» از فرم طرف حساب
  username             String   @map("Username") // اجباری؛ >۵ نویسه؛ یکتا در گرهٔ ساختار
  passwordHash         String   @map("PasswordHash") // scrypt «salt:hash»
  userRoleRef          BigInt   @map("UserRoleRef") // نقش کاربری منتخب
  isActive             Boolean  @default(true) @map("IsActive")
  version              Int      @default(1) @map("Version") // §2.5 auto-rowversion
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  role     UserRole     @relation(fields: [userRoleRef], references: [id])
  accesses UserAccess[]

  @@unique([username, businessStructureRef])
  @@index([partyRef])
  @@map("User")
}

/// UserAccess — ردیف‌های درختوارهٔ دسترسی هر کاربر (Task 126): هر شاخهٔ
/// تأییدشده یک ردیف است. NodeType ∈ "menu" (آیکون اصلی) | "submenu"
/// (زیرمنو) | "form" (فرم) | "action" (آیکون اکشن بار؛ RefKey =
/// "<FormID>:<ActionKey>"). با هر ثبت/ویرایش تراکنشی بازنویسی می‌شود
/// (الگوی محدودهٔ نقش‌ها — Task 100).
model UserAccess {
  id                   BigInt   @id @map("UserAccessID")
  userRef              BigInt   @map("UserRef")
  nodeType             String   @map("NodeType") // "software" | "menu" | "submenu" | "form" | "action" — Task 128: ریشهٔ «نرم افزارها»
  refKey               String   @map("RefKey") // شناسهٔ گره/فرم یا "<FormID>:<ActionKey>" (ریشه: "root")
  version              Int      @default(1) @map("Version")
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")
  user                 User     @relation(fields: [userRef], references: [id], onDelete: Cascade)

  @@unique([userRef, nodeType, refKey])
  @@index([userRef])
  @@map("UserAccess")
}

/// AccountNode — Task 140 (درخواست مالک): فرم «درختواره حسابها» در نرم‌افزار
/// «حسابداری» ← زیرمنوی «اطلاعات پایه» (کامپوننت SimpleTreeForm).
/// درخت ۴ سطحی با ریشهٔ «ساختار کدینگ حساب‌ها»:
///   سطح ۱ = گروه حساب ← سطح ۲ = حساب کل ← سطح ۳ = حساب معین ← سطح ۴ = شاخه تفصیلی
///   · Level — ۱..۴؛ ریشه درختواره مجازی است (ردیف ندارد)؛ parentRef تهی = گروه حساب.
///   · Code — عددی؛ طول مجاز از SoftwareConfig حسابداری خوانده می‌شود
///     (Task 135/137/139): گروه = accGroupCodeLen (پیش‌فرض ۲)،
///     کل = گروه + accLedgerCodeLen (۴)، معین/شاخه = گروه + کل +
///     accSubsidiaryCodeLen (۶). یکتا در ساختار سازمانی.
///   · AccountType — فقط سطح ۱: ۱=ترازنامه‌ای، ۲=سود و زیانی، ۳=انتظامی.
///   · Nature — گروه/کل: ۱=بدهکار، ۲=بستانکار، ۷=مهم نیست؛ معین:
///     ۳=بدهکار طی دوره، ۴=بستانکار طی دوره، ۵=بدهکار پایان دوره،
///     ۶=بستانکار پایان دوره، ۷=مهم نیست؛ شاخه = ۰ (بدون ماهیت).
///   · NatureControl — فقط معین با ماهیت طی دوره (۳/۴): ۱=بدون کنترل،
///     ۲=هشدار و ادامه عملیات، ۳=هشدار و توقف عملیات.
///   · پنج «ویژگی حساب» معین — toggle چندحالته (تفسیر اعلامی §0.6: سه حالت
///     ۰=خاموش / ۱=فعال / ۲=فعال-اجباری با رنگ اختصاصی هر ویژگی در فرم).
/// §16/§2.4/§2.7/§2.5: ID دستی از IDGeneration، بلوک کامل AppBaseEntity.
model AccountNode {
  id                    BigInt   @id @map("AccountNodeID")
  parentRef             BigInt?  @map("ParentRef") // تهی = گروه حساب (زیر ریشهٔ مجازی)
  level                 Int      @map("Level") // ۱..۴
  code                  String   @map("Code")
  title                 String   @map("Title")
  latinTitle            String?  @map("LatinTitle")
  isActive              Boolean  @default(true) @map("IsActive")
  accountType           Int?     @map("AccountType") // فقط سطح ۱
  nature                Int      @default(0) @map("Nature") // ۰ = شاخه تفصیلی
  natureControl         Int?     @map("NatureControl") // فقط معین با ماهیت ۳/۴
  featureQuantitative   Int      @default(0) @map("FeatureQuantitative")
  featureTrackingNumber Int      @default(0) @map("FeatureTrackingNumber")
  featureTrackingDate   Int      @default(0) @map("FeatureTrackingDate")
  featureCurrency       Int      @default(0) @map("FeatureCurrency")
  featureRevaluable     Int      @default(0) @map("FeatureRevaluable")
  version              Int      @default(1) @map("Version") // §2.5 auto-rowversion
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  parent         AccountNode?  @relation("AccountNodeParent", fields: [parentRef], references: [id])
  children       AccountNode[] @relation("AccountNodeParent")
  detailLevels   AccountDetailLevel[]
  adjustments    AccountNatureAdjust[]   @relation("AdjustSource")
  recurringDescs AccountRecurringDesc[]  @relation("RecurringSource")
  allowedUsers   AccountAllowedUser[]    @relation("AllowedUserSource")

  @@unique([code, businessStructureRef])
  @@index([parentRef])
  @@map("AccountNode")
}

/// AccountDetailLevel — تب «سطوح تفصیلی» هر گرهٔ سطح ≥ ۳: سطر «سطح اول» تا
/// «سطح N» بر اساس تنظیم accDetailLevels (پیش‌فرض ۱۰، حداکثر ۲۰ — Task 139).
/// عنوانِ هر سطح قابل ویرایش است؛ «فعال» فقط‌نمایشی (پیش‌فرض فعال).
model AccountDetailLevel {
  id             BigInt  @id @map("AccountDetailLevelID")
  accountNodeRef BigInt  @map("AccountNodeRef")
  levelIndex     Int     @map("LevelIndex") // ۱..۲۰
  title          String  @default("") @map("Title")
  isActive       Boolean @default(true) @map("IsActive")
  version              Int      @default(1) @map("Version")
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  node  AccountNode              @relation(fields: [accountNodeRef], references: [id], onDelete: Cascade)
  types AccountDetailLevelType[]

  @@unique([accountNodeRef, levelIndex])
  @@map("AccountDetailLevel")
}

/// AccountDetailLevelType — انتساب «نوع تفصیلی» (DetailType — Task 120) به یک
/// سطح تفصیلی؛ انواع تکراری/استفاده‌شده در همان گره فیلتر و رد می‌شوند (۴۰۹).
model AccountDetailLevelType {
  id             BigInt @id @map("AccountDetailLevelTypeID")
  detailLevelRef BigInt @map("DetailLevelRef")
  detailTypeRef  BigInt @map("DetailTypeRef") // ارجاع منطقی به DetailType
  version              Int      @default(1) @map("Version")
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  level AccountDetailLevel @relation(fields: [detailLevelRef], references: [id], onDelete: Cascade)

  @@unique([detailLevelRef, detailTypeRef])
  @@index([detailTypeRef])
  @@map("AccountDetailLevelType")
}

/// AccountNatureAdjust — تب «معین تعدیل ماهیت»: حساب معینِ مقابل با ماهیتِ
/// قابل تعدیلِ مخالف (۳↔۴ طی دوره / ۵↔۶ پایان دوره)؛ خودِ حساب جاری مستثنا.
model AccountNatureAdjust {
  id               BigInt  @id @map("AccountNatureAdjustID")
  accountNodeRef   BigInt  @map("AccountNodeRef") // حساب جاری
  adjustAccountRef BigInt  @map("AdjustAccountRef") // حساب معین مقابل (ارجاع منطقی)
  description      String? @map("Description")
  description2     String? @map("Description2")
  version              Int      @default(1) @map("Version")
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  node AccountNode @relation("AdjustSource", fields: [accountNodeRef], references: [id], onDelete: Cascade)

  @@unique([accountNodeRef, adjustAccountRef])
  @@index([adjustAccountRef])
  @@map("AccountNatureAdjust")
}

/// AccountRecurringDesc — تب «شرح های پرتکرار» (شرح و شرح ۲).
model AccountRecurringDesc {
  id             BigInt  @id @map("AccountRecurringDescID")
  accountNodeRef BigInt  @map("AccountNodeRef")
  description    String  @map("Description")
  description2   String? @map("Description2")
  version              Int      @default(1) @map("Version")
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  node AccountNode @relation("RecurringSource", fields: [accountNodeRef], references: [id], onDelete: Cascade)

  @@index([accountNodeRef])
  @@map("AccountRecurringDesc")
}

/// AccountAllowedUser — تب «کاربران مجاز» (فقط وقتی تنظیم
/// enableLedgerAccessControl=true باشد): کاربران با ۶ مجوز سند.
model AccountAllowedUser {
  id             BigInt  @id @map("AccountAllowedUserID")
  accountNodeRef BigInt  @map("AccountNodeRef")
  userRef        BigInt  @map("UserRef") // ارجاع منطقی به User
  permCreate     Boolean @default(false) @map("PermCreate") // ایجاد سند
  permView       Boolean @default(false) @map("PermView") // مشاهده سند
  permEdit       Boolean @default(false) @map("PermEdit") // ویرایش سند
  permDelete     Boolean @default(false) @map("PermDelete") // حذف سند
  permReport     Boolean @default(false) @map("PermReport") // گزارش
  permSend       Boolean @default(false) @map("PermSend") // ارسال اطلاعات
  version              Int      @default(1) @map("Version")
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  node AccountNode @relation("AllowedUserSource", fields: [accountNodeRef], references: [id], onDelete: Cascade)

  @@unique([accountNodeRef, userRef])
  @@index([userRef])
  @@map("AccountAllowedUser")
}
