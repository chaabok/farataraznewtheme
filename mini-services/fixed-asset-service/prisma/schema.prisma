// fixed-asset-service - Prisma schema (PostgreSQL-ready)
//
// MIGRATION TO POSTGRESQL:
//   1. provider = "postgresql"
//   2. url      = env("DATABASE_URL")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:/home/z/my-project/db/fixed_assets.db"
}

model Asset {
  id        String   @id @default(uuid())
  name String
  category String?
  initialValue Float
  depreciationRate Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
