// workflow-service — زیرسیستم گردش کار (Task t177 — فاز ۱: ستون فقرات)
// قراردادها: §2.3 فقط سازه‌های سازگار با PostgreSQL (بدون array/enum/JSON) ·
// §2.5 ردیف‌ورژن خودکار (VERSIONED_MODELS در prisma.service.ts) · §2.6 نام
// ستون‌های PascalCase با @@map · §16 هیچ autoincrement — همهٔ PK های عملیاتی
// دستی از IdGenerationService.
//
// تصمیم‌های قطعی مالک (t176 — بخش ۹ سند مشاوره):
//  D-1 سمت‌های جدید گردش کار (WorkflowRole + WorkflowRoleAssignment) — نه نقش‌های auth
//  D-2 آستانهٔ مبلغ per فرم (WorkflowDefinition.ThresholdAmount)
//  D-3 ورود فقط با وضعیت «تایید کاربر» + اقدام «ارسال به رسیدگی» (نگاشت entry-gate)
//  D-4 وضعیت پایانی = آنچه در گرهٔ پایان فرآیند تعریف شده (WorkflowNode.FinalStatus)
//  D-5 واگردِ پس از تایید نهایی مشروط به نبودِ اقدام آتی (فاز ۲)
//  D-6 بدون محدودیت دوره/سنوات
//  D-7 فیلتر استقرار: اسناد تاییدشدهٔ موجود نمونهٔ گردش ندارند

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// IDGeneration — شمارندهٔ مرکزی per-table (قرارداد §16 — هم‌الگوی settings/dfb).
model IDGeneration {
  idGenerationId BigInt @id @map("IDGenerationID")
  tableName      String @unique @map("TableName")
  lastId         BigInt @default(0) @map("LastID")
  version        Int    @default(1) @map("Version")

  @@map("IDGeneration")
}

/// WorkflowRole — سمت‌های گردش کار (D-1): کد مثل RS-ACCOUNTANT، عنوان
/// «حسابدار رسیدگی». گره‌های اقدام به این کدها ارجاع می‌دهند نه نقش‌های auth.
model WorkflowRole {
  workflowRoleId       BigInt   @id @map("WorkflowRoleID")
  code                 String   @unique @map("Code")
  title                String   @map("Title")
  description          String   @default("") @map("Description")
  isActive             Boolean  @default(true) @map("IsActive")
  isSystem             Boolean  @default(false) @map("IsSystem")
  version              Int      @default(1) @map("Version")
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  @@map("WorkflowRole")
}

/// WorkflowRoleAssignment — تخصیص کاربر به سمت (D-1): userId ارجاع سبک به
/// auth.db؛ بازهٔ اعتبار اختیاری؛ اقدامِ موتور فقط برای دارندهٔ سمتِ گرهٔ جاری.
model WorkflowRoleAssignment {
  workflowRoleAssignmentId BigInt    @id @map("WorkflowRoleAssignmentID")
  roleCode                 String    @map("RoleCode")
  userId                   String    @map("UserID")
  userName                 String    @default("") @map("UserName")
  scope                    String    @default("") @map("Scope") // شعبه/دامنه — فاز ۳
  validFrom                DateTime? @map("ValidFrom")
  validTo                  DateTime? @map("ValidTo")
  isActive                 Boolean   @default(true) @map("IsActive")
  version                  Int       @default(1) @map("Version")
  creator                  String    @map("Creator")
  lastModifier             String?   @map("LastModifier")
  businessStructureRef     BigInt    @map("BusinessStructureRef")
  companyRef               BigInt?   @map("CompanyRef")
  branchRef                BigInt?   @map("BranchRef")
  agencyRef                BigInt?   @map("AgencyRef")
  shopRef                  BigInt?   @map("ShopRef")
  createdAt                DateTime  @default(now()) @map("CreatedAt")
  updatedAt                DateTime  @updatedAt @map("UpdatedAt")

  @@unique([roleCode, userId])
  @@map("WorkflowRoleAssignment")
}

/// WorkflowDefinition — تعریف فرآیند با نسخه (FR-01): فقط یک نسخهٔ فعال per
/// entityType؛ ThresholdAmount = آستانهٔ مبلغ per فرم (D-2) برای شرط موتور قواعد.
/// t180 فاز ۴: Description — توضیح فرآیند؛ نسخه‌های «در استفاده» (با نمونهٔ
/// گردش کار) قطعی‌اند — ویرایش دیاگرام فقط روی نسخهٔ بدون نمونه یا نسخهٔ جدید.
/// t190 — خاتمهٔ فرآیند (فرمان مالک): «فرآیندها ممکن است خاتمه پیدا کنند و
/// فرآیندهای فرم از یک بازه تاریخی تغییر پیدا کند» — نسخهٔ خاتمه‌یافته
/// فقط-خواندنی است (فیلدها + دیاگرام)، از موتور خارج می‌شود (غیرفعال) و
/// «برگشت خاتمه» آن را آزاد می‌کند. TerminationNote = توضیحاتِ مودال خاتمه.
model WorkflowDefinition {
  workflowDefinitionId BigInt   @id @map("WorkflowDefinitionID")
  code                 String   @map("Code") // WF-VOUCHER
  name                 String   @map("Name")
  description          String   @default("") @map("Description") // t180 فاز ۴
  entityType           String   @map("EntityType") // voucher / contract / ...
  processVersion       Int      @map("ProcessVersion")
  thresholdAmount      Float?   @map("ThresholdAmount") // D-2 — آستانهٔ per فرم
  /// t191 — شرط‌های ورود (فیلترها): آرایهٔ JSON از {field,op,value,join}؛
  /// «شامل/بزرگتر از/کوچکتر از/برابر با/شامل نباشد/خالی باشد/خالی نباشد» با
  /// اتصالِ و/یا (ترکیبی). برای فرم «سند حسابداری»: نوع سند، ماهیت سند،
  /// گروه حساب، حساب کل، حساب معین، نوع تفصیلی، جزئیات انواع تفصیلی + مبلغ؛
  /// برای سایر فرم‌ها: مبلغ + شرح/توضیحات. اعتبارسنجی در DefinitionsService.
  conditionsJson       String   @default("[]") @map("ConditionsJson")
  isActive             Boolean  @default(true) @map("IsActive")
  isTerminated         Boolean  @default(false) @map("IsTerminated") // t190
  terminatedAt         DateTime? @map("TerminatedAt") // t190 — تاریخ خاتمه (میلادی)
  terminationNote      String   @default("") @map("TerminationNote") // t190 — توضیحات خاتمه
  version              Int      @default(1) @map("Version")
  creator              String   @map("Creator")
  lastModifier         String?  @map("LastModifier")
  businessStructureRef BigInt   @map("BusinessStructureRef")
  companyRef           BigInt?  @map("CompanyRef")
  branchRef            BigInt?  @map("BranchRef")
  agencyRef            BigInt?  @map("AgencyRef")
  shopRef              BigInt?  @map("ShopRef")
  createdAt            DateTime @default(now()) @map("CreatedAt")
  updatedAt            DateTime @updatedAt @map("UpdatedAt")

  @@unique([code, processVersion])
  @@map("WorkflowDefinition")
}

/// WorkflowNode — گره‌ها (FR-02/03): nodeType = start | action | condition | end؛
/// FinalStatus فقط روی گرهٔ پایان — وضعیت پایانی سند (D-4)؛ InstanceState روی
/// گرهٔ پایان = سرنوشت نمونه (approved / rejected).
/// t180 فاز ۴: PosX/PosY — مختصات بوم طراح بصری (جابجایی با درگ؛ ذخیره با
/// endpoint layout حتی برای نسخه‌های در استفاده — صرفاً نمایشی و بی‌اثر بر موتور).
model WorkflowNode {
  workflowNodeId BigInt  @id @map("WorkflowNodeID")
  definitionId   BigInt  @map("DefinitionID")
  nodeCode       String  @map("NodeCode") // N1..N7 — مرجع پایدار گذارها
  nodeType       String  @map("NodeType")
  title          String  @map("Title")
  roleCode       String  @default("") @map("RoleCode") // فقط گرهٔ action
  slaHours       Int?    @map("SLAHours")
  orderIndex     Int     @default(0) @map("OrderIndex")
  finalStatus    Int?    @map("FinalStatus") // D-4 — فقط گرهٔ پایان
  instanceState  String  @default("") @map("InstanceState") // فقط گرهٔ پایان
  posX           Int     @default(0) @map("PosX") // t180 فاز ۴ — بوم طراح
  posY           Int     @default(0) @map("PosY") // t180 فاز ۴ — بوم طراح

  @@unique([definitionId, nodeCode])
  @@map("WorkflowNode")
}

/// WorkflowTransition — گذارها (FR-04): از/به گره با اقدام استاندارد؛ شرط
/// (مثل amount > threshold) روی گذارِ خروجی گرهٔ شرط؛ IsDefault = شاخهٔ «خیر».
model WorkflowTransition {
  workflowTransitionId BigInt  @id @map("WorkflowTransitionID")
  definitionId         BigInt  @map("DefinitionID")
  fromNodeId           BigInt  @map("FromNodeID")
  toNodeId             BigInt  @map("ToNodeID")
  action               String  @map("Action") // ارسال به رسیدگی / تایید / رد / ابطال
  conditionExpr        String  @default("") @map("ConditionExpr")
  isDefault            Boolean @default(false) @map("IsDefault")

  @@map("WorkflowTransition")
}

/// WorkflowInstance — نمونهٔ در جریان (قلب موتور): ارجاع سبک entityType+entityID
/// به سند (هیچ دادهٔ فرم کپی نمی‌شود)؛ CurrentState = running/approved/rejected/
/// cancelled؛ یکی per سند (قفل هم‌زمانی FR-06 با بررسی running).
model WorkflowInstance {
  workflowInstanceId   BigInt    @id @map("WorkflowInstanceID")
  definitionId         BigInt    @map("DefinitionID")
  processVersion       Int       @map("ProcessVersion")
  entityType           String    @map("EntityType")
  entityId             String    @map("EntityID")
  entityLabel          String    @default("") @map("EntityLabel") // نمایش (مثل شمارهٔ سند)
  currentNodeId        BigInt    @map("CurrentNodeID")
  currentState         String    @default("running") @map("CurrentState")
  startedBy            String    @map("StartedBy")
  startedByName        String    @default("") @map("StartedByName")
  startedAt            DateTime  @default(now()) @map("StartedAt")
  finishedAt           DateTime? @map("FinishedAt")
  finalStatus          Int?      @map("FinalStatus") // D-4 — از گرهٔ پایان
  version              Int       @default(1) @map("Version")
  creator              String    @map("Creator")
  lastModifier         String?   @map("LastModifier")
  businessStructureRef BigInt    @map("BusinessStructureRef")
  companyRef           BigInt?   @map("CompanyRef")
  branchRef            BigInt?   @map("BranchRef")
  agencyRef            BigInt?   @map("AgencyRef")
  shopRef              BigInt?   @map("ShopRef")
  createdAt            DateTime  @default(now()) @map("CreatedAt")
  updatedAt            DateTime  @updatedAt @map("UpdatedAt")

  @@index([entityType, entityId])
  @@index([currentState])
  @@map("WorkflowInstance")
}

/// WorkflowActionLog — تاریخچهٔ append-only (FR-10): هیچ UPDATE/CDELETE —
/// هر اقدام با بازیگر، گره از/به، اقدام، دلیل و زمان؛ خط زمانی فرم سند (فاز ۲).
/// t179 فاز ۳: ViaDelegation/DelegatorID — حسابرسی کامل اقدامِ تفویضی (FR-09):
/// اگر اقدام توسط نمایندهٔ تفویض‌گرفته ثبت شود پرچم می‌خورد و تفویض‌کننده ثبت است.
model WorkflowActionLog {
  workflowActionLogId BigInt   @id @map("WorkflowActionLogID")
  instanceId          BigInt   @map("InstanceID")
  fromNodeId          BigInt   @default(0) @map("FromNodeID")
  toNodeId            BigInt   @default(0) @map("ToNodeID")
  action              String   @map("Action")
  actorId             String   @map("ActorID")
  actorName           String   @default("") @map("ActorName")
  roleCode            String   @default("") @map("RoleCode")
  comment             String   @default("") @map("Comment")
  viaDelegation       Boolean  @default(false) @map("ViaDelegation") // t179 — اقدام تفویضی
  delegatorId         String   @default("") @map("DelegatorID") // t179 — تفویض‌کننده
  createdAt           DateTime @default(now()) @map("CreatedAt")

  @@index([instanceId])
  @@map("WorkflowActionLog")
}

/// WorkflowNotification — ابلاغ/کارتابل (FR-07/08 فاز ۳؛ ردیف‌ها از فاز ۱
/// هنگام پارک نمونه روی گره ساخته می‌شوند): گیرنده سمت/کاربر + خواندن.
/// t179 فاز ۳: Kind — action (ابلاغ گام) | info (اطلاع آغازگر) | sla (هشدار
/// تأخیر SLA) — برای تفکیک کارتابل و جلوگیری از تکرار هشدار SLA per گره.
model WorkflowNotification {
  workflowNotificationId BigInt    @id @map("WorkflowNotificationID")
  instanceId             BigInt    @map("InstanceID")
  nodeId                 BigInt    @map("NodeID")
  kind                   String    @default("action") @map("Kind")
  recipientRoleCode      String    @default("") @map("RecipientRoleCode")
  recipientUserId        String    @default("") @map("RecipientUserID")
  title                  String    @map("Title")
  body                   String    @default("") @map("Body")
  sentAt                 DateTime  @default(now()) @map("SentAt")
  readAt                 DateTime? @map("ReadAt")

  @@index([instanceId])
  @@map("WorkflowNotification")
}

/// WorkflowDelegation — تفویض به‌نیابت بازه‌دار (FR-09 — t179 فاز ۳):
/// دارندهٔ سمت (delegator) اقدام گام‌های آن سمت را در یک بازهٔ زمانی به
/// نماینده (delegate) می‌سپارد؛ موتور در نبودِ تخصیص مستقیم، تفویضِ معتبر را
/// می‌پذیرد و اقدام را «تفویضی» در تاریخچه ثبت می‌کند. سمت سیستمی ماند و
/// تفویض فقط جانشینِ موقت است — مسئولیت حقوقی با تفویض‌کننده.
model WorkflowDelegation {
  workflowDelegationId BigInt    @id @map("WorkflowDelegationID")
  roleCode             String    @map("RoleCode")
  delegatorUserId      String    @map("DelegatorUserID")
  delegatorName        String    @default("") @map("DelegatorName")
  delegateUserId       String    @map("DelegateUserID")
  delegateName         String    @default("") @map("DelegateName")
  validFrom            DateTime  @map("ValidFrom")
  validTo              DateTime? @map("ValidTo") // null = تا اطلاع ثانوی
  comment              String    @default("") @map("Comment")
  isActive             Boolean   @default(true) @map("IsActive")
  version              Int       @default(1) @map("Version")
  creator              String    @map("Creator")
  lastModifier         String?   @map("LastModifier")
  businessStructureRef BigInt    @map("BusinessStructureRef")
  companyRef           BigInt?   @map("CompanyRef")
  branchRef            BigInt?   @map("BranchRef")
  agencyRef            BigInt?   @map("AgencyRef")
  shopRef              BigInt?   @map("ShopRef")
  createdAt            DateTime  @default(now()) @map("CreatedAt")
  updatedAt            DateTime  @updatedAt @map("UpdatedAt")

  @@unique([roleCode, delegatorUserId, delegateUserId])
  @@index([delegateUserId])
  @@index([delegatorUserId])
  @@map("WorkflowDelegation")
}

/// WorkflowStatusMap — نگاشت وضعیت فرم به چرخه (FR-11؛ D-3): GateType =
/// pre-entry | entry-gate | excluded | engine-final. برای سند:
/// ۱ pre-entry · ۵ entry-gate (تایید کاربر) · ۲ excluded (یادداشت) · ۳/۴ engine-final.
model WorkflowStatusMap {
  workflowStatusMapId BigInt   @id @map("WorkflowStatusMapID")
  entityType          String   @map("EntityType")
  formStatus          Int      @map("FormStatus")
  gateType            String   @map("GateType")
  description         String   @default("") @map("Description")
  version             Int      @default(1) @map("Version")
  creator             String   @map("Creator")
  lastModifier        String?  @map("LastModifier")
  businessStructureRef BigInt  @map("BusinessStructureRef")
  companyRef          BigInt?  @map("CompanyRef")
  branchRef           BigInt?  @map("BranchRef")
  agencyRef           BigInt?  @map("AgencyRef")
  shopRef             BigInt?  @map("ShopRef")
  createdAt           DateTime @default(now()) @map("CreatedAt")
  updatedAt           DateTime @updatedAt @map("UpdatedAt")

  @@unique([entityType, formStatus])
  @@map("WorkflowStatusMap")
}

/// WorkflowEntityCatalog — دفتر فرم‌های دارای فیلد وضعیت (t180 فاز ۴ — تصمیم
/// مالک: «فرم‌هایی که قرار است در گردش کار شرکت داشته باشند باید توسط کاربر
/// انتخاب شود»). اینجا کاتالوگ فرم‌های کاندید است؛ Participates = انتخاب
/// کاربر برای مشارکت در چرخه. AdapterReady یعنی آداپتور مشترک روی آن فرم
/// متصل شده (فعلاً فقط سند حسابداری — t178)؛ فرم بدون آداپتور انتخاب‌شدنی نیست.
/// موتور شروع نمونه را برای فرمِ غیرمشارکت با خطای صریح می‌بندد.
model WorkflowEntityCatalog {
  workflowEntityCatalogId BigInt   @id @map("WorkflowEntityCatalogID")
  entityType              String   @unique @map("EntityType")
  formTitle               String   @map("FormTitle")
  softwareName            String   @default("") @map("SoftwareName")
  description             String   @default("") @map("Description")
  hasStatusField          Boolean  @default(true) @map("HasStatusField")
  adapterReady            Boolean  @default(false) @map("AdapterReady")
  participates            Boolean  @default(false) @map("Participates")
  version                 Int      @default(1) @map("Version")
  creator                 String   @map("Creator")
  lastModifier            String?  @map("LastModifier")
  businessStructureRef    BigInt   @map("BusinessStructureRef")
  companyRef              BigInt?  @map("CompanyRef")
  branchRef               BigInt?  @map("BranchRef")
  agencyRef               BigInt?  @map("AgencyRef")
  shopRef                 BigInt?  @map("ShopRef")
  createdAt               DateTime @default(now()) @map("CreatedAt")
  updatedAt               DateTime @updatedAt @map("UpdatedAt")

  @@map("WorkflowEntityCatalog")
}

/// WorkflowDependency — دفتر وابستگی واگرد (D-5 — t178 فاز ۲): هر فرم
/// مصرف‌کننده که بر اساس سندِ تاییدشده «اقدام آتی» ثبت کند، یک ردیف اینجا
/// می‌نویسد (endpoint داخلی با کلید موتور — فرم‌های آینده). واگردِ تایید
/// نهایی فقط وقتی مجاز است که برای نمونه هیچ ردیفی ثبت نشده باشد.
model WorkflowDependency {
  workflowDependencyId BigInt   @id @map("WorkflowDependencyID")
  instanceId           BigInt   @map("InstanceID")
  dependentEntityType  String   @map("DependentEntityType") // payment / contract / ...
  dependentEntityId    String   @map("DependentEntityID")
  dependentEntityLabel String   @default("") @map("DependentEntityLabel")
  registeredBy         String   @default("") @map("RegisteredBy")
  createdAt            DateTime @default(now()) @map("CreatedAt")

  @@unique([instanceId, dependentEntityType, dependentEntityId])
  @@map("WorkflowDependency")
}
