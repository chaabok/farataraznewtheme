// costing-service - Prisma schema (PostgreSQL-ready)
//
// MIGRATION TO POSTGRESQL:
//   1. provider = "postgresql"
//   2. url      = env("DATABASE_URL")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:/home/z/my-project/db/costing.db"
}

model CostItem {
  id        String   @id @default(uuid())
  product String
  materialCost Float @default(0)
  laborCost Float @default(0)
  overhead Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
